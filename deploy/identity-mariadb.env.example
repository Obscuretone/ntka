IDENTITY_ORIGIN=https://login.example.com
IDENTITY_STORAGE=mariadb
IDENTITY_DATA=/var/lib/ntka
IDENTITY_MARIADB_DATABASE=ntka
IDENTITY_MARIADB_USER=ntka
IDENTITY_MARIADB_SOCKET=/run/mysqld/mysqld.sock
# For password authentication, add a private service-readable file path.
# IDENTITY_MARIADB_PASSWORD_FILE=/run/credentials/ntka.service/mariadb-password
