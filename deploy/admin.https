limit_req_zone $binary_remote_addr zone=obscuretone_identity:1m rate=15r/s;
limit_req_zone $binary_remote_addr zone=obscuretone_passkey:1m rate=4r/s;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.obscuretone.com;
    ssl_certificate /etc/letsencrypt/live/login.obscuretone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/login.obscuretone.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    access_log off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    return 308 https://login.obscuretone.com/manage;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name login.obscuretone.com;
    ssl_certificate /etc/letsencrypt/live/login.obscuretone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/login.obscuretone.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    access_log off;
    client_max_body_size 64k;
    limit_req zone=obscuretone_identity burst=30 nodelay;
    limit_req_status 429;
    location ^~ /passkeys/ {
        limit_req zone=obscuretone_passkey burst=12 nodelay;
        include /opt/obscuretone-identity/deploy/proxy.conf;
    }
    location / {
        include /opt/obscuretone-identity/deploy/proxy.conf;
    }
}
